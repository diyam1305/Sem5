CREATE TABLE Faculty
(
	ID INT IDENTITY(1,1) PRIMARY KEY,
	FirstName NVARCHAR(100) NOT NULL,
	LastName NVARCHAR(100) NOT NULL,
	ContactNo BIGINT NOT NULL,
	EmailID NVARCHAR(50) NOT NULL,
)
 
