import 'dart:io';
void main()
{
  List <int> numbers = [];
  print("Enter n:");
  int n = int.parse(stdin.readLineSync()!);
  int evenCount = 0;
  int oddCount = 0;

  for(int i = 0; i < n; i++)
  {
    print("Enter element-${i + 1}");
    int num = int.parse(stdin.readLineSync()!);
  }

  for(int num in numbers)
  {
    if(num % 2 == 0)
    {
      evenCount++;
    }
    else
    {
      oddCount++;
    }
  }
  print("Even numbers count:$evenCount");
  print("Odd numbrs count:$oddCount");
}
